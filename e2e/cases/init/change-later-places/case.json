{
	"steps": [
		[
			"init",
			"-y",
			"--skip-git"
		],
		[
			"$",
			"node",
			"-e",
			"const fs=require('fs');const s=fs.readFileSync('default.rogen.json','utf8');const t=s.replace('\"routes\"','// mine\\n  \"routes\"');if(t===s)process.exit(1);fs.writeFileSync('default.rogen.json',t)"
		],
		[
			"build"
		],
		[
			"init",
			"-y",
			"--places"
		],
		[
			"build"
		],
		[
			"init",
			"places/shop",
			"-y"
		],
		[
			"build"
		]
	],
	"show": [
		"README.md"
	]
}