{
	"syncRules": [
		{ "pattern": "*.server.lang", "use": "serverScript", "suffix": ".server.lang" },
		{ "pattern": "*.client.lang", "use": "clientScript", "suffix": ".client.lang" },
		{ "pattern": "*.lang", "use": "moduleScript", "suffix": ".lang" }
	],
	"sourcePaths": [
		"src"
	],
	"routes": {
		"server": "ServerScriptService",
		"client": "StarterPlayer/StarterPlayerScripts",
		"*": "ReplicatedStorage/shared"
	}
}
