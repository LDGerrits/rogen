{
	"name": "Inventory",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Packages": {
				"$path": "Packages"
			},
			"DevPackages": {
				"$path": "DevPackages"
			}
		}
	},
	"globIgnorePaths": [
		"DevPackages/**"
	],
	"rogen": {
		"sourcePaths": [
			"src"
		],
		"routes": {
			"server": "ServerScriptService",
			"client": "StarterPlayer/StarterPlayerScripts",
			"shared": "ReplicatedStorage/shared",
			"*": "ReplicatedStorage/shared"
		}
	}
}
