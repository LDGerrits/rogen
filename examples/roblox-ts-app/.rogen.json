{
	"source": ["src"],
	"casing": "camelCase",
	"ts": {
		"output": "default.project.json",
		"build": "out"
	},
	"project": {
		"name": "roblox-project",
		"globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
		"tree": {
			"$className": "DataModel",
			"ServerScriptService": {
				"ServerPackages": {
					"$path": "ServerPackages"
				}
			},
			"ReplicatedStorage": {
				"rbxts_include": {
					"$path": "include",
					"node_modules": {
						"$className": "Folder",
						"@rbxts": {
							"$path": "node_modules/@rbxts"
						}
					}
				},
				"Packages": {
					"$path": "Packages"
				}
			}
		}
	}
}
