{
	"name": "@ldgerrits/rogen",
	"version": "2.0.0-beta.1",
	"description": "A Rojo superset with file-system routing. Organize by feature.",
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://rogen-roblox.vercel.app/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LDGerrits/rogen.git"
	},
	"keywords": [
		"roblox",
		"rojo",
		"luau",
		"roblox-ts",
		"roblox-studio",
		"feature-based-architecture",
		"vertical-slice-architecture",
		"folder-structure",
		"file-based-routing",
		"sync",
		"cli"
	],
	"author": "ldgerrits",
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"docs"
	],
	"files": [
		"dist/bundle.cjs",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"prepare": "node scripts/prepare.ts",
		"clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
		"prebuild": "npm run generate",
		"build": "tsc",
		"prebundle": "npm run generate",
		"bundle": "node scripts/bundle.ts",
		"prebundle:watch": "npm run generate",
		"bundle:watch": "esbuild bin/rogen.ts --bundle --platform=node --format=cjs --external:*.node --main-fields=module,main --define:import.meta.dirname=__dirname --outfile=dist/bundle.cjs --watch",
		"prepublishOnly": "npm run clean && npm run build && npm run bundle",
		"pretest": "npm run generate",
		"test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
		"pretest:watch": "npm run generate",
		"test:watch": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --watch",
		"pretest:unit": "npm run generate",
		"test:unit": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config jest.unit.config.js",
		"pretest:changed": "npm run generate",
		"test:changed": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config jest.unit.config.js --onlyChanged --passWithNoTests",
		"pretest:e2e": "npm run generate",
		"test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config jest.e2e.config.js",
		"test:e2e:update": "node scripts/summarize-transcripts.ts --update",
		"test:e2e:diff": "node scripts/summarize-transcripts.ts",
		"eval:agents": "node evals/agents/run.mjs",
		"pretypecheck": "npm run generate",
		"typecheck": "tsc -p e2e && tsc -p scripts",
		"check": "npm run lint && npm run build && npm run typecheck && npm test",
		"prelint": "npm run generate",
		"lint": "eslint .",
		"generate": "tsx scripts/generate.ts",
		"generate:templates": "tsx scripts/generate.ts",
		"generate:services": "tsx scripts/generate-services.ts",
		"lint:fix": "eslint . --fix",
		"release:local": "npm run bundle && node scripts/make-binary.ts releases/rogen",
		"version": "tsx scripts/sync-version.ts"
	},
	"bin": {
		"rogen": "dist/bundle.cjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.0.1",
		"@types/picomatch": "^4.0.3",
		"ajv": "^8.20.0",
		"esbuild": "^0.28.1",
		"eslint": "^10.6.0",
		"eslint-plugin-jest": "^29.15.4",
		"jest": "^30.4.2",
		"ts-jest": "^29.4.11",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1"
	},
	"dependencies": {
		"@clack/core": "^1.5.1",
		"@clack/prompts": "^1.8.1",
		"@msgpack/msgpack": "^3.1.3",
		"chokidar": "^3.6.0",
		"jsonc-parser": "^3.3.1",
		"picomatch": "^4.0.5"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"sharp@0.34.5": true,
		"unrs-resolver@1.12.2": true
	}
}
