{
	"name": "rogen",
	"workspaces": [
		"docs"
	],
	"version": "1.4.0",
	"description": "A tool for feature-based folder structures with Rojo.",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"bundle": "esbuild bin/rogen.ts --bundle --platform=node --format=cjs --external:*.node --outfile=dist/bundle.cjs",
		"release:local": "npm run bundle && npx pkg dist/bundle.cjs --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path releases/"
	},
	"main": "dist/src/index.js",
	"bin": {
		"rogen": "./dist/bin/rogen.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.0.1",
		"@types/picomatch": "^4.0.3",
		"esbuild": "^0.28.1",
		"eslint": "^10.6.0",
		"eslint-plugin-jest": "^29.15.4",
		"jest": "^30.4.2",
		"ts-jest": "^29.4.11",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1"
	},
	"dependencies": {
		"@fumadocs/base-ui": "^16.12.1",
		"chokidar": "^3.6.0",
		"cnfast": "^0.0.8",
		"framer-motion": "^12.42.2",
		"fumadocs-core": "^16.12.1",
		"fumadocs-ui": "npm:@fumadocs/base-ui@^16.12.1",
		"lucide-react": "^1.27.0",
		"picomatch": "^4.0.5",
		"react": "^19.2.8",
		"react-icons": "^5.7.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"sharp@0.34.5": true,
		"unrs-resolver@1.12.2": true
	}
}
