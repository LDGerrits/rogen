{
	"name": "rogen",
	"version": "1.4.0",
	"description": "Feature-based folder routing for Roblox",
	"author": "ldgerrits",
	"license": "MIT",
	"type": "module",
	"workspaces": [
		"docs"
	],
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"prepare": "npm run bundle",
		"build": "tsc",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"bundle": "esbuild bin/rogen.ts --bundle --platform=node --format=cjs --external:*.node --outfile=dist/bundle.cjs",
		"release:local": "npm run bundle && npx pkg dist/bundle.cjs --targets node18-win-x64,node18-linux-x64,node18-macos-x64 --out-path releases/"
	},
	"main": "dist/src/index.js",
	"bin": {
		"rogen": "./dist/bundle.cjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.0.1",
		"@types/picomatch": "^4.0.3",
		"esbuild": "^0.28.1",
		"eslint": "^10.6.0",
		"eslint-plugin-jest": "^29.15.4",
		"jest": "^30.4.2",
		"ts-jest": "^29.4.11",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1"
	},
	"dependencies": {
		"chokidar": "^3.6.0",
		"picomatch": "^4.0.5"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"sharp@0.34.5": true,
		"unrs-resolver@1.12.2": true
	}
}
